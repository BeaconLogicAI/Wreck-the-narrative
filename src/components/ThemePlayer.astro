---
// Compact "Hear the theme" player. Renders only when THEME_SONG_URL is set.
// Self-contained: play/pause, progress bar, time. Safe to use on multiple pages.
import { THEME_SONG_URL, THEME_SONG_TITLE } from '../lib/site';
interface Props { label?: string; }
const { label = 'Hear the theme' } = Astro.props;
---
{THEME_SONG_URL && (
  <div class="theme-player" data-theme-player>
    <button type="button" class="tp-btn" aria-label="Play the theme song">
      <svg class="tp-ic tp-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
      <svg class="tp-ic tp-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
    </button>
    <div class="tp-body">
      <div class="tp-top">
        <span class="tp-label">{label}</span>
        <span class="tp-time" aria-hidden="true">0:00</span>
      </div>
      <div class="tp-bar" role="presentation"><span class="tp-fill"></span></div>
      <div class="tp-title">{THEME_SONG_TITLE}</div>
    </div>
    <audio preload="none" src={THEME_SONG_URL}></audio>
  </div>
)}

<script>
  document.querySelectorAll('[data-theme-player]').forEach((root) => {
    const el = root as HTMLElement & { __tpInit?: boolean };
    if (el.__tpInit) return;
    el.__tpInit = true;
    const audio = root.querySelector('audio') as HTMLAudioElement;
    const btn = root.querySelector('.tp-btn') as HTMLButtonElement;
    const play = root.querySelector('.tp-play') as SVGElement;
    const pause = root.querySelector('.tp-pause') as SVGElement;
    const fill = root.querySelector('.tp-fill') as HTMLElement;
    const time = root.querySelector('.tp-time') as HTMLElement;
    if (!audio || !btn) return;
    const fmt = (s: number) => {
      s = Math.floor(s || 0);
      return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    };
    // One audio at a time across every player on the page (inline + floating).
    document.addEventListener('wtn:audio-play', (e) => {
      if ((e as CustomEvent).detail !== audio) audio.pause();
    });
    btn.addEventListener('click', () => {
      if (audio.paused) {
        document.dispatchEvent(new CustomEvent('wtn:audio-play', { detail: audio }));
        audio.play();
      } else {
        audio.pause();
      }
    });
    audio.addEventListener('play', () => {
      play.hidden = true; pause.hidden = false;
      btn.setAttribute('aria-label', 'Pause the theme song');
    });
    audio.addEventListener('pause', () => {
      play.hidden = false; pause.hidden = true;
      btn.setAttribute('aria-label', 'Play the theme song');
    });
    audio.addEventListener('timeupdate', () => {
      const d = audio.duration || 0;
      fill.style.width = d ? `${(audio.currentTime / d) * 100}%` : '0%';
      time.textContent = fmt(audio.currentTime);
    });
    audio.addEventListener('ended', () => { fill.style.width = '0%'; time.textContent = '0:00'; });
  });
</script>

<style>
  .theme-player { display: flex; align-items: center; gap: 1rem; max-width: 420px; padding: .85rem 1rem; background: var(--bg-2); border: 1px solid var(--line); border-radius: 12px; }
  .tp-btn { flex: none; width: 46px; height: 46px; display: grid; place-items: center; border-radius: 50%; border: 0; cursor: pointer; background: var(--flame); color: oklch(0.16 0.02 45); transition: background .25s var(--ease), transform .25s var(--ease); }
  .tp-btn:hover { background: var(--flame-hot); transform: scale(1.05); }
  .tp-ic { width: 20px; height: 20px; }
  .tp-body { flex: 1; min-width: 0; }
  .tp-top { display: flex; align-items: baseline; justify-content: space-between; gap: .5rem; }
  .tp-label { font-family: "Oswald"; font-weight: 600; text-transform: uppercase; letter-spacing: .14em; font-size: .72rem; color: var(--ink); }
  .tp-time { font-family: "Oswald"; font-size: .72rem; color: var(--steel); font-variant-numeric: tabular-nums; }
  .tp-bar { height: 4px; border-radius: 100px; background: var(--bg-3); margin: .5rem 0 .4rem; overflow: hidden; }
  .tp-fill { display: block; height: 100%; width: 0%; background: var(--flame); border-radius: 100px; transition: width .15s linear; }
  .tp-title { font-size: .78rem; color: var(--steel); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
