---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="That page wandered off. Here's the way back.">
  <section class="hero" style="min-height:52vh; display:grid; align-items:center;">
    <div class="shell hero-stack">
      <div class="status"><span class="dot"></span> Error 404</div>
      <h1 class="hero-headline">This page got <em>wrecked.</em></h1>
      <p class="hero-lede">The page you're after isn't here. The truth still is — head back and keep listening.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-ghost" href="/episodes">Browse episodes</a>
      </div>
    </div>
  </section>
</BaseLayout>
