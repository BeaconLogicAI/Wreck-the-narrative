---
import BaseLayout from '../layouts/BaseLayout.astro';
import Support from '../components/Support.astro';
---
<BaseLayout title="Support the Show" description="Wreck the Narrative is listener-supported. Chip in monthly and help keep the truth free for everyone.">
  <section class="page-hero">
    <div class="shell">
      <span class="kicker">Support</span>
      <h1>Stand behind <em>the truth.</em></h1>
      <p class="lede">The show is free, and we want to keep it that way. Monthly support from listeners is what makes that possible.</p>
    </div>
  </section>

  <Support />
</BaseLayout>
